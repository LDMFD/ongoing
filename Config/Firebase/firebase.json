{
  "hosting": {
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "ongoing-api",
          "region": "europe-west2"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "ongoing-dashboard",
          "region": "europe-west2"
        }
      }
   ]
  }
}